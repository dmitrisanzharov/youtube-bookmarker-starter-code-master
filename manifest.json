{
    "manifest_version": 3,
    "name": "aaa_Chrome_Extension_By_Dmitri",
    "version": "0.1.0",
    "description": "Saving timestamps in YT videos",
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://*.youtube.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
             "matches": ["<all_urls>"],
            "js": ["my_content.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["assets/bookmark.png", "assets/play.png", "assets/delete.png", "assets/save.png"],
            "matches": ["https://*.youtube.com/*"]
        }
    ],
    "action": {
        "default_title": "aaa_Chrome_Extension_By_Dmitri",
        "default_icon": "assets/ext-icon.png",
        "default_popup": "my_popup.html"
    }
}
